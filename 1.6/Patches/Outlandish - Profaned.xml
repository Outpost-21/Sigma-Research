<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        =================================================================================
        ============================= Outlandish - Profaned =============================
        =================================================================================
    -->

    <!-- ============================= Basic profane insight ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/tab</xpath>
                    <value>
                        <tab>Sigma_Medieval</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]</xpath>
                    <value>
                        <tab>Sigma_Medieval</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/techLevel</xpath>
                    <value>
                        <techLevel>Medieval</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]</xpath>
                    <value>
                        <techLevel>Medieval</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/researchViewX</xpath>
                    <value>
                        <researchViewX>3</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]</xpath>
                    <value>
                        <researchViewX>3</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]/researchViewY</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_ProfanedBasics"]</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

