<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ==================================================================================
        ============================= Progression: Education =============================
        ==================================================================================
    -->

    <!-- ============================= Basic education ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/tab</xpath>
                    <value>
                        <tab>Sigma_Neolithic</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]</xpath>
                    <value>
                        <tab>Sigma_Neolithic</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/techLevel</xpath>
                    <value>
                        <techLevel>Neolithic</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]</xpath>
                    <value>
                        <techLevel>Neolithic</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/researchViewX</xpath>
                    <value>
                        <researchViewX>3</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]</xpath>
                    <value>
                        <researchViewX>3</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]/researchViewY</xpath>
                    <value>
                        <researchViewY>2.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="Ferny_NeolithicEducation"]</xpath>
                    <value>
                        <researchViewY>2.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

