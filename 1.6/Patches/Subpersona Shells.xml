<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        =============================================================================
        ============================= Subpersona Shells =============================
        =============================================================================
    -->

    <!-- ============================= Subpersona shells ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/tab</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/techLevel</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/researchViewX</xpath>
                    <value>
                        <researchViewX>4</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]</xpath>
                    <value>
                        <researchViewX>4</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]/researchViewY</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SubAI_SubpersonaShell"]</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

</Patch>
