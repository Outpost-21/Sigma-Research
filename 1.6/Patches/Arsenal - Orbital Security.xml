<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ======================================================================================
        ============================= Arsenal - Orbital Security =============================
        ======================================================================================
    -->

    <!-- ============================= Fusion weapons ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/tab</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/techLevel</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/researchViewX</xpath>
                    <value>
                        <researchViewX>10</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]</xpath>
                    <value>
                        <researchViewX>10</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]/researchViewY</xpath>
                    <value>
                        <researchViewY>2.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="FusionWeapons"]</xpath>
                    <value>
                        <researchViewY>2.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

