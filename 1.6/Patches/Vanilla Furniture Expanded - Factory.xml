<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ================================================================================================
        ============================= Vanilla Furniture Expanded - Factory =============================
        ================================================================================================
    -->

    <!-- ============================= Basic factories ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/tab</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/techLevel</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/researchViewX</xpath>
                    <value>
                        <researchViewX>5</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]</xpath>
                    <value>
                        <researchViewX>5</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]/researchViewY</xpath>
                    <value>
                        <researchViewY>3.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_BasicFactories"]</xpath>
                    <value>
                        <researchViewY>3.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

    <!-- ============================= Complex factories ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/tab</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/techLevel</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewX</xpath>
                    <value>
                        <researchViewX>6</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]</xpath>
                    <value>
                        <researchViewX>6</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]/researchViewY</xpath>
                    <value>
                        <researchViewY>3.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFE_ComplexFactories"]</xpath>
                    <value>
                        <researchViewY>3.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

</Patch>
