<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        =====================================================================================
        ============================= Outlandish - Divine Order =============================
        =====================================================================================
    -->

    <!-- ============================= Divine order equipment ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/tab</xpath>
                    <value>
                        <tab>Sigma_Medieval</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]</xpath>
                    <value>
                        <tab>Sigma_Medieval</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/techLevel</xpath>
                    <value>
                        <techLevel>Medieval</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]</xpath>
                    <value>
                        <techLevel>Medieval</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/researchViewX</xpath>
                    <value>
                        <researchViewX>1</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]</xpath>
                    <value>
                        <researchViewX>1</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]/researchViewY</xpath>
                    <value>
                        <researchViewY>2</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="BotchJob_DivineOrderSmithing"]</xpath>
                    <value>
                        <researchViewY>2</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

