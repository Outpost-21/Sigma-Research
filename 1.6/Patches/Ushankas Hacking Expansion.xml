<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ======================================================================================
        ============================= Ushankas Hacking Expansion =============================
        ======================================================================================
    -->

    <!-- ============================= Basic cybertech ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/tab</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]</xpath>
                    <value>
                        <tab>Sigma_Industrial</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/techLevel</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]</xpath>
                    <value>
                        <techLevel>Industrial</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/researchViewX</xpath>
                    <value>
                        <researchViewX>10</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]</xpath>
                    <value>
                        <researchViewX>10</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]/researchViewY</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="USH_BasicCybertech"]</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

