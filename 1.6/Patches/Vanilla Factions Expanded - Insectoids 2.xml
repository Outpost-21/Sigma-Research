<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ====================================================================================================
        ============================= Vanilla Factions Expanded - Insectoids 2 =============================
        ====================================================================================================
    -->

    <!-- ============================= Basic hivetech ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/tab</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]</xpath>
                    <value>
                        <tab>Sigma_Spacer</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/techLevel</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]</xpath>
                    <value>
                        <techLevel>Spacer</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/researchViewX</xpath>
                    <value>
                        <researchViewX>2</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]</xpath>
                    <value>
                        <researchViewX>2</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]/researchViewY</xpath>
                    <value>
                        <researchViewY>5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="VFEI2_BasicHivetech"]</xpath>
                    <value>
                        <researchViewY>5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

