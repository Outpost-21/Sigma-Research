<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ================================================================================
        ============================= Scar's Basic Farming =============================
        ================================================================================
    -->

    <!-- ============================= Basic farming ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/tab</xpath>
                    <value>
                        <tab>Sigma_Neolithic</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]</xpath>
                    <value>
                        <tab>Sigma_Neolithic</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/techLevel</xpath>
                    <value>
                        <techLevel>Neolithic</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]</xpath>
                    <value>
                        <techLevel>Neolithic</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/researchViewX</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]/researchViewY</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="scar_basicFarming"]</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

