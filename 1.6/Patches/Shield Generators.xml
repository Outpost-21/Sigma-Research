<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        =============================================================================
        ============================= Shield Generators =============================
        =============================================================================
    -->

    <!-- ============================= Basic shield tech ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/tab</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/techLevel</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/researchViewX</xpath>
                    <value>
                        <researchViewX>4</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]</xpath>
                    <value>
                        <researchViewX>4</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]/researchViewY</xpath>
                    <value>
                        <researchViewY>0</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="ShieldGen_BasicShieldTech"]</xpath>
                    <value>
                        <researchViewY>0</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

