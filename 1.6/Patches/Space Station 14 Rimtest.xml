<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--
        ====================================================================================
        ============================= Space Station 14 Rimtest =============================
        ====================================================================================
    -->

    <!-- ============================= Station furniture ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/tab</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/techLevel</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/researchViewX</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]/researchViewY</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationFurniture"]</xpath>
                    <value>
                        <researchViewY>0.5</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

    <!-- ============================= Station doors ============================= -->

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]</xpath>
        <match Class="PatchOperationSequence">
            <operations>
            <!-- ============================= Research Tab ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/tab</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/tab</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]</xpath>
                    <value>
                        <tab>Sigma_Ultratech</tab>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Tech Level ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/techLevel</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/techLevel</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]</xpath>
                    <value>
                        <techLevel>Ultra</techLevel>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Horizontal Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/researchViewX</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/researchViewX</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]</xpath>
                    <value>
                        <researchViewX>0</researchViewX>
                    </value>
                </nomatch>
            </li>
            <!-- ============================= Vertical Position ============================= -->
            <li Class="PatchOperationConditional">
                <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/researchViewY</xpath>
                <match Class="PatchOperationReplace">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]/researchViewY</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </match>
                <nomatch Class="PatchOperationAdd">
                    <xpath>/Defs/ResearchProjectDef[defName="SS14_StationDoors"]</xpath>
                    <value>
                        <researchViewY>1</researchViewY>
                    </value>
                </nomatch>
            </li>
            </operations>
        </match>
    </Operation>

</Patch>
